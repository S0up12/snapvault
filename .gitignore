# ============================================================
# SnapVault .gitignore
# Enforces the Security & Version Control rules in AGENT.md:
# no server data, no secrets, no user data, no build artifacts.
# ============================================================

# --- Dependencies ---
node_modules/

# --- Frontend build output (Vite) ---
dist/
dist-ssr/
*.local

# --- Rust / Tauri build output ---
# (src-tauri/ has its own .gitignore too; this covers the tree from root)
/src-tauri/target/
/src-tauri/gen/schemas/
**/target/

# --- Environment variables & secrets ---
.env
.env.*
!.env.example

# Tauri updater / code-signing private keys (never commit the private half)
*.key
!*.key.pub
*.pem
*.p12
*.pfx
*.keystore
*.jks

# --- Local databases (SQLite) ---
*.db
*.db-journal
*.db-wal
*.db-shm
/btw*.sqlite
*.sqlite3
*.sqlite3-journal

# --- Extracted Snapchat archive data & generated media ---
# Raw user exports, ingested media, and derived thumbnails must never
# be committed - this is private user data, not application code.
/data/
/uploads/
/exports/
/extracted/
/thumbnails/
*.snapvault-export/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- OS-generated files ---
# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Linux
*~
.directory
.Trash-*

# --- Editor / IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
