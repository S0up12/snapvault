{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapVault",
  "version": "0.1.0",
  "identifier": "com.snapvault.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SnapVault",
        "width": 800,
        "height": 600,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/thumbnails/*", "$APPDATA/playback/*", "$APPDATA/imports/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "S0up12",
    "copyright": "Copyright © 2026 S0up12",
    "homepage": "https://github.com/S0up12/snapvault",
    "category": "Photography",
    "shortDescription": "Browse your exported Snapchat data offline",
    "longDescription": "SnapVault is a self-hosted, offline-first desktop viewer for exported Snapchat data: memories, chats and profile. Everything stays on your device.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
